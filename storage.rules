rules_version = '2';

// Deploy: Firebase Console → Storage → Rules (paste this file)
// Or: firebase deploy --only storage  (from project root, after firebase login)
service firebase.storage {
  match /b/{bucket}/o {

    function isImageUpload() {
      return request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/octet-stream'
        );
    }

    // Admin: Sync Division Images (mx.png, da.png, vd.png) — no Firebase Auth in this app
    match /tcs/all-products-images/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024;
    }

    // Engineer / service center photos
    match /engineers/{fileName} {
      allow read: if true;
      allow write: if isImageUpload();
    }

    match /PQA/{fileName} {
      allow read: if true;
      allow write: if isImageUpload();
    }

    match /mx/{fileName} {
      allow read: if true;
      allow write: if isImageUpload();
    }

    match /da/{fileName} {
      allow read: if true;
      allow write: if isImageUpload();
    }

    match /av/{fileName} {
      allow read: if true;
      allow write: if isImageUpload();
    }
  }
}
