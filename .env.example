# Copy to `.env.local` for local development (never commit real secrets).

# --- Bootstrap admin (only when Firestore has zero admins, e.g. first install / offline)
# Password must match login: use the same string you would pass to btoa() in the browser for your password.
# Example: in DevTools console: btoa('MySecret123')  → paste result below
NEXT_PUBLIC_BOOTSTRAP_ADMIN_PASSWORD_B64=
NEXT_PUBLIC_BOOTSTRAP_ADMIN_USERNAME=admin
NEXT_PUBLIC_BOOTSTRAP_ADMIN_NAME=Super Admin

# --- Firebase App Check (optional; reduces automated abuse against your Firebase APIs)
# Create reCAPTCHA v3 in Google Cloud, register the site key in Firebase Console → App Check, then:
NEXT_PUBLIC_FIREBASE_APPCHECK_KEY=

# --- Firebase Storage (required for Sync Division Images + engineer photo upload)
# If you see storage/unauthorized: deploy storage.rules (see docs/FIREBASE_STORAGE.md)
# Console: Firebase → tcs-for-engineers → Storage → Rules → paste storage.rules → Publish

# --- GoGo AI assistant (Gemini — server-side only; never expose to NEXT_PUBLIC_*)
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
# Without this key, GoGo still works with guided menu chips + browser voice, but smart chat / Gemini TTS fall back.
# Product specs (Option D): /api/gogo/product-gemini uses the same key to ground answers on GSMArena + Google Search.
# After editing, restart `npm run dev` so Next.js reloads env vars.
GEMINI_API_KEY=
# Prefer gemini-flash-latest / gemini-flash-lite-latest (older 2.5-flash-lite may 404 for new keys)
GEMINI_MODEL=gemini-flash-latest
# GoGo voice — permanent FREE Egyptian Arabic (no paid plan):
# Microsoft Edge neural male ar-EG-ShakirNeural
GOGO_EDGE_VOICE_EN=en-US-AndrewNeural
GOGO_EDGE_VOICE_AR=ar-EG-ShakirNeural
GOGO_EDGE_RATE_AR=+8%
GOGO_EDGE_PITCH_AR=-2Hz
# Optional PAID only: ElevenLabs Hanafi library voice (free plan cannot use it via API)
# Preview sample kept at public/gogo/voice_preview_hanafi.mp3 for reference
# ELEVENLABS_ENABLED=1
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_AR=DWMVT5WflKt0P8OPpIrY
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional Gemini TTS backup (often quota-limited on free tier)
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE_EN=Charon
GEMINI_TTS_VOICE_AR=Orus

