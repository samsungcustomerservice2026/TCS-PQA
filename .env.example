# Copy to `.env.local` for local development (never commit real secrets).

# --- Firebase Admin SDK (SERVER ONLY — required for quiz scoring, host APIs, Excel commit, admin bootstrap)
# Paste the full service account JSON as a single line, or base64-encode it.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=tcs-for-engineers
# One-time first admin creation (header x-bootstrap-secret or body.bootstrapSecret)
BOOTSTRAP_ADMIN_SECRET=

# --- Firebase App Check (optional public site key)
NEXT_PUBLIC_FIREBASE_APPCHECK_KEY=

# --- Optional Sentry
# NEXT_PUBLIC_SENTRY_DSN=

# --- GoGo voice (NO Gemini)
GOGO_EDGE_VOICE_EN=en-US-AndrewNeural
GOGO_EDGE_VOICE_AR=ar-EG-ShakirNeural
GOGO_EDGE_RATE_AR=+8%
GOGO_EDGE_PITCH_AR=-2Hz
# ELEVENLABS_ENABLED=1
# ELEVENLABS_API_KEY=

# DEPRECATED — do not use (removed as auth mechanism):
# NEXT_PUBLIC_BOOTSTRAP_ADMIN_PASSWORD_B64
# GEMINI_API_KEY
